#!/bin/sh
# ==============================================================================
# box-firewall on|off — CÔNG TẮC MẠNG của box (quy tắc ②a/②b, mục 7.4.1)
#
# Thực thi bằng iptables NGAY TRONG container. Đây là CÔNG TẮC CHÍNH SÁCH EGGRESS
# duy nhất. NAT ra internet do Docker quản mặc định (không còn driver_opts
# enable_ip_masquerade:false — cờ đó không nhất quán Windows/Linux). Mặc định khi
# box khởi động: OFF.
#
#   BẬT : POST /__box/network body "on"  (backend giữ X-BoxFox-Api-Key)
#   TẮT : POST /__box/network body "off"
#   Thủ công để gỡ lỗi: docker exec --user root agentbox-box box-firewall on|off
#
# Yêu cầu cap NET_ADMIN (khai trong docker-compose.yml). Mọi lần gọi phải ghi
# sổ audit với actor: user (②c) — Controller làm việc đó ở backend.
# ==============================================================================
set -eu

case "${1:-}" in
  off)
    iptables -F OUTPUT
    # Cho phép loopback (mọi dịch vụ nội bộ nói chuyện với nhau qua lo)
    iptables -A OUTPUT -o lo -j ACCEPT
    # CHỈ ACCEPT established/related cho 4 cổng dịch vụ của box. Điều này ngăn
    # Chrome tái dùng HTTP keep-alive ra internet: kết nối ra ngoài có source
    # port ngẫu nhiên cao (32768–60999) → không match rule nào → rớt xuống REJECT.
    iptables -A OUTPUT -p tcp --sport 5900 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT  # VNC
    iptables -A OUTPUT -p tcp --sport 6080 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT  # websockify
    iptables -A OUTPUT -p tcp --sport 8080 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT  # code-server
    iptables -A OUTPUT -p tcp --sport 8081 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT  # ide-proxy
    # REJECT thay vì DROP âm thầm: trình duyệt báo lỗi NGAY thay vì xoay mãi.
    iptables -A OUTPUT -j REJECT
    iptables -P OUTPUT DROP
    echo off > /run/box-net-state
    chmod 644 /run/box-net-state
    echo "[box-firewall] OFF — data plane đã đóng"
    ;;
  on)
    iptables -P OUTPUT ACCEPT
    iptables -F OUTPUT
    echo on > /run/box-net-state
    chmod 644 /run/box-net-state
    echo "[box-firewall] ON — data plane mở toàn phần"
    ;;
  *)
    echo "dùng: box-firewall on|off" >&2
    exit 2
    ;;
esac
