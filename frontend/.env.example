# Nguồn dữ liệu của giao diện.
#   mock = phát lại kịch bản demo 8 bước ngay trong trình duyệt (mặc định)
#   live = nối WebSocket tới backend thật
VITE_TRANSPORT=mock

# Chỉ dùng khi VITE_TRANSPORT=live.
# Backend chỉ nên nghe trên loopback và kiểm header Origin (mục 12.6).
VITE_AGENT_WS_URL=ws://127.0.0.1:8765
