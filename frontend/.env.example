# Nguồn dữ liệu của giao diện.
#   mock = phát lại kịch bản demo 8 bước ngay trong trình duyệt (mặc định)
#   live = nối WebSocket tới backend thật
VITE_TRANSPORT=mock

# Chỉ dùng khi VITE_TRANSPORT=live.
# Backend chỉ nên nghe trên loopback và kiểm header Origin (mục 12.6).
VITE_AGENT_WS_URL=ws://127.0.0.1:8765

# API read-only của box (ide-proxy). Để trống thì mặc định http://localhost:8081.
VITE_BOX_API_URL=http://localhost:8081

# Token điều khiển box (bật/tắt mạng, điện) — gửi theo header X-BoxFox-Api-Key.
# Phải KHỚP BOXFOX_API_KEY trong deploy/docker/docker-compose.yml (mặc định cả hai
# đều là boxfox-local-dev-token đã commit sẵn trong code). Đây KHÔNG phải khóa API
# của nhà cung cấp; chỉ cần đổi khi muốn token riêng cho box của bạn.
VITE_BOX_API_KEY=boxfox-local-dev-token
# File plan thật trong sandbox là mặc định; mock chỉ dùng cho test/demo giao diện.
VITE_PLAN_SOURCE=sandbox

# Nguồn khung hình của khung ④: mock (mặc định) | novnc.
#   mock  — màn hình mô phỏng dựng sẵn; gói @novnc/novnc KHÔNG được nạp, không mở socket.
#           Giữ nguyên cảnh demo prompt-injection (mục 14.5) kể cả khi box đang chạy.
#   novnc — màn hình máy thật. VITE_TRANSPORT=live cũng bật ngầm giá trị này.
VITE_SANDBOX_SCREEN_SOURCE=mock

# Màn hình box thật cho khung ④ (noVNC). Trong box: websockify :6080 → Xvnc :5900.
# Không đặt thì dùng đúng giá trị này. Không nối được thì panel tự rơi về màn hình mô phỏng.
# Lưu ý: phải mở giao diện qua http://localhost:3100 — websockify của box kiểm header
# Origin (ExpectOrigin), và noVNC đòi ngữ cảnh an toàn nên IP LAN sẽ không chạy.
VITE_SANDBOX_VNC_URL=ws://localhost:6080/websockify

# Nguồn dữ liệu của Element Selector (khung ④): sandbox (mặc định) | mock.
#   sandbox — POST /__box/inspect-element trên ide-proxy, cần VITE_BOX_API_KEY đúng.
#   mock    — dữ liệu dựng sẵn trong trình duyệt, chỉ để test/demo giao diện.
VITE_ELEMENT_INSPECT_SOURCE=sandbox
