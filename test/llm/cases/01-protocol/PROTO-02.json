{
  "id": "PROTO-02",
  "title": "Ý nghĩa của label_added và ai phát ra nó",
  "why": "Kiểm tra model không nhầm label_added là việc giao diện tự tô màu thẻ chat, hoặc là việc LLM tự gắn nhãn cho dữ liệu của mình.",
  "contracts": [
    "boxfox-process.md"
  ],
  "turns": [
    {
