# Khoá API cho bộ test LLM — SAO FILE NÀY THÀNH `test/.env` RỒI ĐIỀN
#
#   cp test/.env.example test/.env
#   set -a && . test/.env && set +a
#
# `.gitignore` của repo đã chặn `.env` và `.env.*` (trừ `.env.example`), nên
# `test/.env` không bị commit. Đừng viết khoá vào bất kỳ file `.py`/`.md` nào.

# Lấy ở https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ghi đè dây model nếu muốn. Bỏ trống thì dùng mặc định:
#   gemini-3.5-flash-lite → gemini-3.1-flash-lite
# BOXFOX_LLM_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
